="2.8" stroke="currentColor" stroke-width="1.4"></circle><path d="M4.5 16.5c.7-3 2.7-4.5 5.5-4.5s4.8 1.5 5.5 4.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path></svg>Concierge</a></li><li><a class="flex items-center gap-2.5 rounded-kuteka px-3 py-2.5 text-sm font-medium transition-colors duration-200 text-slate-200 hover:bg-white/10 hover:text-white" href="/app/garantia/"><svg viewBox="0 0 20 20" fill="none" class="size-4 shrink-0" aria-hidden="true"><path d="M10 2.8 16 5v4.8c0 3.6-2.4 5.8-6 7.4-3.6-1.6-6-3.8-6-7.4V5l6-2.2Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"></path></svg>Garantia Kuteka</a></li><li><a class="flex items-center gap-2.5 rounded-kuteka px-3 py-2.5 text-sm font-medium transition-colors duration-200 text-slate-200 hover:bg-white/10 hover:text-white" href="/app/assistencia/"><svg viewBox="0 0 20 20" fill="none" class="size-4 shrink-0" aria-hidden="true"><path d="M12.5 4.5a3 3 0 0 0-4.2 4.2L4 13l3 3 4.3-4.3a3 3 0 0 0 4.2-4.2L13.5 9.5 12.5 4.5Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"></path></svg>Assistência 24h</a></li><li><a class="flex items-center gap-2.5 rounded-kuteka px-3 py-2.5 text-sm font-medium transition-colors duration-200 text-slate-200 hover:bg-white/10 hover:text-white" href="/app/servicos/"><svg viewBox="0 0 20 20" fill="none" class="size-4 shrink-0" aria-hidden="true"><path d="M12.5 4.5a3 3 0 0 0-4.2 4.2L4 13l3 3 4.3-4.3a3 3 0 0 0 4.2-4.2L13.5 9.5 12.5 4.5Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"></path></svg>Prestadores</a></li><li><a class="flex items-center gap-2.5 rounded-kuteka px-3 py-2.5 text-sm font-medium transition-colors duration-200 text-slate-200 hover:bg-white/10 hover:text-white" href="/app/perfil/"><svg viewBox="0 0 20 20" fill="none" class="size-4 shrink-0" aria-hidden="true"><circle cx="10" cy="7" r="3" stroke="currentColor" stroke-width="1.4"></circle><path d="M4.5 16c1-3 2.8-4.5 5.5-4.5s4.5 1.5 5.5 4.5" stroke="cur