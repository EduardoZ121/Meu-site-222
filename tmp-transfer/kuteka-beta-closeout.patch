\"subtitle\":\"Regras de utilização da plataforma Kuteka, papéis, serviços, pagamentos, cancelamentos e responsabilidades.\",\"versionNote\":\"Versão 1.0 Beta · Vigência 5 de Agosto de 2026 · kutekalink.com\",\"markdown\":\"$9\",\"downloads\":[{\"label\":\"Descarregar PDF\",\"href\":\"/docs/TERMOS_UTILIZACAO_v1.pdf\"},{\"label\":\"Descarregar Word\",\"href\":\"/docs/TERMOS_UTILIZACAO_v1.docx\"},{\"label\":\"Markdown\",\"href\":\"/docs/TERMOS_UTILIZACAO_v1.md\"}]}],null,\"$La\"]}],{},null,false]},null,false]},null,false]},null,false],\"$Lb\",false]],\"m\":\"$undefined\",\"G\":[\"$c\",[]],\"s\":false,\"S\":true}\n"])</script><script>self.__next_f.push([1,"d:I[56974,[],\"OutletBoundary\"]\nf:I[41795,[],\"AsyncMetadataOutlet\"]\n11:I[56974,[],\"ViewportBoundary\"]\n13:I[56974,[],\"MetadataBoundary\"]\n14:\"$Sreact.suspense\"\na:[\"$\",\"$Ld\",null,{\"children\":[\"$Le\",[\"$\",\"$Lf\",null,{\"promise\":\"$@10\"}]]}]\nb:[\"$\",\"$1\",\"h\",{\"children\":[null,[[\"$\",\"$L11\",null,{\"children\":\"$L12\"}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]],[\"$\",\"$L13\",null,{\"children\":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$14\",null,{\"fallback\":null,\"children\":\"$L15\"}]}]}]]}]\n"])</script><script>self.__next_f.push([1,"12:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\ne:null\n"])</script><script>self.__next_f.push([1,"16:I[27803,[],\"IconMark\"]\n10:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"Termos de Utilização · Kuteka · Kuteka\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Termos e Condições de Utilização da plataforma Kuteka — direitos, deveres, Kuteka Pay, KIS, contratos e comissões.\"}],[\"$\",\"meta\",\"2\",{\"name\":\"robots\",\"content\":\"index, follow\"}],[\"$\",\"link\",\"3\",{\"rel\":\"icon\",\"href\":\"/favicon.svg\",\"type\":\"image/svg+xml\"}],[\"$\",\"link\",\"4\",{\"rel\"